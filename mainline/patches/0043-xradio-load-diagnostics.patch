+/* Read-only load diagnostics; reset when the module is reloaded. */
+static int load_diag_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", atomic_read(kp->arg));
+}
+static const struct kernel_param_ops load_diag_ops = { .get = load_diag_get };
+#define LOAD_DIAG(name) \
+	static atomic_t name = ATOMIC_INIT(0); \
+	module_param_cb(name, &load_diag_ops, &name, 0444)
+static void load_diag_max(atomic_t *counter, unsigned int value)
+{
+	int old = atomic_read(counter);
+	int next = min_t(unsigned int, value, INT_MAX);
+
+	while (next > old) {
+		int seen = atomic_cmpxchg(counter, old, next);
+		if (seen == old)
+			break;
+		old = seen;
+	}
+}
+LOAD_DIAG(diag_host_queue_max_ms);
+LOAD_DIAG(diag_host_queue_over_100ms);
+LOAD_DIAG(diag_host_queue_expired);
 
